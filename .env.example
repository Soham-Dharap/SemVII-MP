# --- Database (MongoDB Atlas free M0 cluster) ---
DATABASE_URL="mongodb+srv://codepilot_user:<password>@cluster0.3amwwry.mongodb.net/codepilot?retryWrites=true&w=majority&appName=Cluster0"

# --- NextAuth ---
# Generate locally with: openssl rand -base64 32
AUTH_SECRET="<generate-a-long-random-secret>"
# Trust the host header behind Render's reverse proxy.
AUTH_TRUST_HOST="true"

# --- GitHub OAuth ---
# https://github.com/settings/developers -> New OAuth App
# Callback URL: https://<your-app>.onrender.com/api/auth/callback/github
AUTH_GITHUB_ID="<github-oauth-client-id>"
AUTH_GITHUB_SECRET="<github-oauth-client-secret>"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials -> Create OAuth client
# Redirect URI: https://<your-app>.onrender.com/api/auth/callback/google
AUTH_GOOGLE_ID="<google-client-id>.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="<google-client-secret>"
